<header id="header">
  <div class="container top-navigation">
    <%= render "layouts/body/languages" %>
    <nav class="main-menu" aria-label="<%= t("general.top_navigation_label") %>">
      <ul class="nav navbar-nav">
        <li class="<%= active?(home_path) %>">
          <%= link_to t("home.title", default: "Home"), home_path, 'aria-current': (current_page?(home_path) ? 'page' : nil) %>
        </li>
        <li class="<%= active?(/^#{config.relative_url_root}\/browse/,
          request.path) %>">
          <%= link_to t("browse.title", default: "Browse"), browse_path, 'aria-current': (current_page?(browse_path) ? 'page' : nil) %>
        </li>
        <li class="<%= active?(search_path) %>">
          <%= link_to t("search.title", default: "Search"), search_path, rel: "search", 'aria-current': (current_page?(search_path) ? 'page' : nil) %>
        </li>
        <li class="<%= active?(about_path) %>">
          <%= link_to t("about.title", default: "About"), about_path, 'aria-current': (current_page?(about_path) ? 'page' : nil) %>
        </li>
      </ul>
    </nav>
    <%# Calls modal %>
    <div class="dedication-button">
      <button class="btn btn-link" data-toggle="modal" data-target="#dedication">
        <%= t "general.dedication_button" %>
      </button>
    </div>
  </div>

  <div class="letter_top_greeting">
    <div class="container">
      <%= image_tag "letter_top_greeting.png", alt: t("general.header_image_alt") %>
    </div>
  </div>
  <div class="container title_nav">
    <div class="title_nav_sub">
      <%= render "layouts/body/title" %>
      <%= render "layouts/body/navbar" %>
      <%= render "layouts/body/breadcrumbs" %>
    </div> <%# /title_nav_sub %>
  </div> <%# /container %>
</header> <%# /header %>
