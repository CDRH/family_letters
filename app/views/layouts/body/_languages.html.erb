<% if APP_OPTS["all_languages"].present? && APP_OPTS["all_languages"][/\|/] %>
  <nav class="navbar language-choice" aria-label="Language choice">
    <ul class="language_link nav navbar-nav" role="group">
      <% APP_OPTS["all_languages"].split("|").each do |lang_code| %>
        <li>
        <%# create link to switch languages that keeps current parameters %>
        <%# TODO a11y / ARIA markup for full language names? %>
        <% if lang_code == I18n.locale.to_s %>
          <a href="#" class="btn btn-primary notranslate"
            hreflang="<%= lang_code %>"
            rel="alternate" 
            <% if lang_code == "en" %>
              aria-label="English"
            <% elsif lang_code == "es" %>
              aria-label="Español"
              <% end %>
            aria-disabled="true" 
            aria-current="true" %>
            <%= lang_code.upcase %>
          </a>
        <% else %>
          <%# a11y / ARIA markup for full language name? %>
            <a href="<%= locale_link(lang_code) %>" 
            class="btn btn-default notranslate"
            hreflang="<%= lang_code %>"
              rel="alternate" 
              <% if lang_code == "en" %>
                aria-label="Inglés"
              <% elsif lang_code == "es" %>
                aria-label="Spanish"
              <% end %>
              aria-disabled="true" 
              aria-current="true" %>
              <%= lang_code.upcase %>
            </a>
        <% end %>
        </li>
      <% end %>
    </ul>
  </nav>
<% end %>
