<!DOCTYPE html>
<html lang="<%= I18n.locale %>" <%= site_section %>>
  <%= render "layouts/head/head" %>
  <body class="<%= "language_#{I18n.locale}" %>">
    <div id="body-wrapper">
      <%= render "layouts/body/skip_to_main" %>
      <%= render "layouts/body/header" %>
      <%= render "layouts/body/contents" %>
      <%= render "layouts/body/footer" %>
      <div class="letter_bottom_farewell">
        <div class="container">
          <%= image_tag "letter_bottom_farewell.png", alt: t("general.footer_image_alt")  %>
        </div>
      </div>
    </div>
  </body>
</html>
