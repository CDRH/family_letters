<% @ext_css = add_assets(@ext_css, ["fancybox.min"]) %>
<% @ext_js = add_assets(@ext_js, ["fancybox-3.5.7"]) %>
<% @inline_js = ['$(function() {$(".pageimage a").attr("data-fancybox", "gallery").fancybox();});'] %>

<%# overridden for purpose of toggling the title language %>
<% if @res %>
  <h2><%= title_label(@res) %></h2>

  <%= render "show_metadata" %>
  <%= render "show_content" %>

<% else %>

  <h2><%= t("item.not_found", default: "Not Found") %></h2>
  <%= t "item.no_item", id: params["id"], default: "No item with identifier #{params["id"]} found!" %>

<% end %>
